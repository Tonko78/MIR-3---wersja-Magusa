+    private static void SetHash(Registration registration, string hash, byte[] value)
+    {
+        switch (hash)
+        {
+            case "password":
+                registration.PasswordHash = value;
+                break;
+            case "token":
+                registration.VerificationTokenHash = value;
+                break;
+            case "ip":
