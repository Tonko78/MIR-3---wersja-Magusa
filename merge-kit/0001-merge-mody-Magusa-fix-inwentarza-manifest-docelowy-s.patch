+            {
+                ["ConnectionStrings:Portal"] = $"Data Source={Path.Combine(_root, "portal.db")}",
+                ["VerificationDelivery:LockDirectory"] = locks,
+                ["Queue:RootPath"] = queue,
+                ["Queue:ResultPollSeconds"] = "2",
