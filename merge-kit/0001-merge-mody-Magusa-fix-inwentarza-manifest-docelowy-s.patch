+
+    private AccountCommand WriteSignedCommand(Guid id, DateTimeOffset? issuedAt = null)
+    {
+        var command = CreateCommand(id, issuedAt ?? Now);
+        AccountCommandSigner.Sign(command, KeyBase64);
+        WriteIncoming(command);
+        return command;
+    }
