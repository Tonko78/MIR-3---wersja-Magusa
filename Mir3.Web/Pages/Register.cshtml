@page
@model Mir3.Web.Pages.RegisterModel
@{
    ViewData["Title"] = PortalText.Pick("Create an account", "Utwórz konto");
    // Keep English client hints; suppress untranslated annotations for Polish.
    if (CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "pl")
        ViewContext.ClientValidationEnabled = false;
}

<section class="page-intro" aria-labelledby="register-heading">
    <p class="eyebrow">@PortalText.Pick("NEW ARRIVAL", "NOWY GRACZ")</p>
    <h1 id="register-heading">@PortalText.Pick("Create your Mir3 account.", "Utwórz konto Mir3.")</h1>
    <p>@PortalText.Pick("Your e-mail address is your game login. Passwords must be 5–15 characters with no whitespace.", "Adres e-mail będzie Twoim loginem do gry. Hasło musi mieć 5–15 znaków i nie może zawierać białych znaków.")</p>
</section>

@if (Model.ResultMessage is not null)
{
    <div role="status" class="status-note @Model.ResultMessageCssClass"><span class="status-icon" aria-hidden="true">@Model.ResultMessageIcon</span><span>@Model.ResultMessage</span></div>
}

<form method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="field">
        <label asp-for="Input.Email">@PortalText.Pick("Email", "Adres e-mail")</label>
        <input asp-for="Input.Email" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Password">@PortalText.Pick("Password", "Hasło")</label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Input.ConfirmPassword">@PortalText.Pick("ConfirmPassword", "Potwierdź hasło")</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
    </div>
    <div class="check-field">
        <input asp-for="Input.AcceptRules" />
        <label asp-for="Input.AcceptRules">@PortalText.Pick("I accept the server rules.", "Akceptuję regulamin serwera.")</label>
        <span asp-validation-for="Input.AcceptRules" class="field-error"></span>
    </div>
    <button type="submit" class="button button--primary">@PortalText.Pick("Register", "Zarejestruj się")</button>
</form>
